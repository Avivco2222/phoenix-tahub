# Phoenix Talent OS — Frontend environment variables (dev sample).
# Copy to phoenix-dashboard/.env.local and fill real values.

# Empty → use relative /api/* URLs proxied by next.config.ts rewrites.
# Non-empty → cross-origin override (rare; e.g. preview deploys).
NEXT_PUBLIC_API_URL=

# Strict mode: when true, screens that depend on live backend data refuse
# to render demo fallbacks if the backend is unreachable. Recommended for
# any non-throwaway environment so missing data is visible immediately.
NEXT_PUBLIC_STRICT_LIVE_DATA=true

# NOTE: There is intentionally no NEXT_PUBLIC_ADMIN_API_TOKEN here.
# All admin auth flows through the session cookie (fnx_access_token) that
# /api/auth/login sets — same-origin requests via Next.js rewrites carry
# it automatically. NEXT_PUBLIC_* variables ship in the browser bundle,
# so an admin shortcut token there would be readable by every visitor.
# If you need an admin shortcut for non-browser tests, keep the token on
# the backend (backend/.env: ADMIN_API_TOKEN) and send X-Admin-Token from
# the test harness only.
