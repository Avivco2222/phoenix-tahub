# Phoenix Talent OS — Backend environment variables
# Copy to backend/.env and fill real values. NEVER commit backend/.env.
#
# In production set every "Required" var via the platform's secret store
# (Vercel env, 1Password Connect, AWS Secrets Manager, etc.) — never via
# a committed file.

# ---- Required ----
# Without JWT_SECRET the backend refuses to start.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# ---- Deployment environment ----
# Set to "production" in production deployments. Activates safety guards:
#   * POST /admin/reset-for-final-test → 410 Gone (irrecoverable wipe is
#     blocked when ENV=production).
# Anything else (dev / test / staging / unset) keeps the dev defaults.
ENV=dev

# ---- Optional (defaults shown in comments) ----
JWT_TTL_MINUTES=120                     # token lifetime in minutes
ADMIN_API_TOKEN=replace-with-strong-admin-token
SESSION_UNLOCK_PIN=replace-with-strong-session-pin
MAX_UPLOAD_MB=10                        # ingestion file size cap
MAX_INGEST_ERROR_RATE=0.2               # max share of bad rows tolerated

# Set 1 in production (HTTPS). 0 only for local HTTP dev.
COOKIE_SECURE=1
